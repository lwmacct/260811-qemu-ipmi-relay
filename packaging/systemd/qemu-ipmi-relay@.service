[Unit]
Description=QEMU IPMI relay for %i
After=systemd-modules-load.service
ConditionPathExists=/dev/ipmi0

[Service]
Type=simple
User=root
Group=incus
UMask=0007
RuntimeDirectory=qemu-ipmi-relay
RuntimeDirectoryMode=0750
ExecStart=/usr/local/sbin/qemu-ipmi-relay --config /etc/qemu-ipmi-relay/%i.toml
Restart=on-failure
RestartSec=1s

NoNewPrivileges=yes
CapabilityBoundingSet=
LockPersonality=yes
MemoryDenyWriteExecute=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ReadWritePaths=/run/qemu-ipmi-relay
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
